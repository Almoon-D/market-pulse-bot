# Copy to .env and fill in the values for your chosen backend.
# src/config.py (pydantic-settings) reads this automatically; only the
# block matching MERCADOS_NOTIFICATION_BACKEND needs to be filled in.

MERCADOS_NOTIFICATION_BACKEND=discord
MERCADOS_DISPLAY_TIMEZONE=Europe/Madrid
MERCADOS_LANGUAGE=es

# --- discord ---
# The webhook URL as given by Discord (Channel Settings -> Integrations ->
# Webhooks). DiscordBackend appends ?wait=true itself on the first POST.
MERCADOS_DISCORD_WEBHOOK_URL=

# --- slack ---
# A BOT token (starts with xoxb-) with the chat:write scope. A plain
# incoming webhook cannot edit messages, so it will not work here.
MERCADOS_SLACK_BOT_TOKEN=
MERCADOS_SLACK_CHANNEL=

# --- telegram ---
# Bot token from @BotFather, and the numeric chat_id to post into (a
# group's is negative, e.g. -1001234567890).
MERCADOS_TELEGRAM_BOT_TOKEN=
MERCADOS_TELEGRAM_CHAT_ID=
