# systemd unit for daemon (--loop) mode.
#
# Install:
#   sudo cp deploy/mercados.service /etc/systemd/system/mercados.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mercados
#
# Requires a Python 3.14 interpreter. If your distro's default `python3` is
# older, install 3.14 via pyenv/deadsnakes/the official installer (see
# README.md) and point ExecStart at that interpreter explicitly — do not
# rely on a `python3` symlink that might silently resolve to an older
# version after an OS update.

[Unit]
Description=mercados — global market-status monitor (daemon mode)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=mercados
Group=mercados
WorkingDirectory=/opt/mercados

# Explicit interpreter path — never a bare "python3" that could resolve to
# a pre-3.14 system interpreter after an unrelated OS package update.
ExecStart=/opt/mercados/.venv/bin/python3.14 main.py --loop --interval 30 --incident-interval 90

# data/state.json must survive restarts — it is the durable record of
# which Discord/Slack/Telegram message backs each of the three slots.
# WorkingDirectory above already points at the persistent install, so the
# relative "data/" path resolves there; StateDirectory additionally makes
# systemd create and preserve it with correct permissions.
StateDirectory=mercados
StateDirectoryMode=0750

EnvironmentFile=/opt/mercados/.env

Restart=on-failure
RestartSec=10
TimeoutStopSec=15

# Hardening (adjust if your distro's systemd is older and rejects any of these)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/mercados/data
ProtectHome=true

[Install]
WantedBy=multi-user.target
